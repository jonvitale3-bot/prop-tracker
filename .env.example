# Copy this file to .env (worker) and web/.env.local (Next.js)
# and fill in the real values. Never commit .env files.

# ── Database ────────────────────────────────────────────────
# Neon connection string. Use the *pooled* one for the web app
# and the *direct* one for the worker (migrations + long jobs).
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_DIRECT=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Anthropic (Claude) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Apify ──────────────────────────────────────────────────
APIFY_TOKEN=apify_api_...
# Actor IDs we'll choose in the ingester step (format: username~actorname)
APIFY_REDDIT_ACTOR=trudax~reddit-scraper-lite
APIFY_TWITTER_ACTOR=apidojo~tweet-scraper

# ── The Odds API ───────────────────────────────────────────
# https://the-odds-api.com  (used to fetch closing lines for grading)
ODDS_API_KEY=your_odds_api_key_here

# ── Worker config ──────────────────────────────────────────
LOG_LEVEL=INFO
# Comma-separated subreddits to monitor
REDDIT_SUBREDDITS=sportsbook,nba,nbabetting
# Comma-separated Twitter search queries
TWITTER_QUERIES=NBA player prop,NBA lock tonight
