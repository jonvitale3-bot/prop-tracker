# Copy this file to .env and fill in the real values.
# Both the Python worker (via dotenv) and Next.js (via Next's built-in
# .env loader) read from this single file at the repo root.
# Never commit .env files.

# ── Database ────────────────────────────────────────────────
# Neon connection string. Use the *pooled* one for the web app
# and the *direct* one for the worker (migrations + long jobs).
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_DIRECT=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Anthropic (Claude) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Apify ──────────────────────────────────────────────────
APIFY_TOKEN=apify_api_...
# Actor IDs we'll choose in the ingester step (format: username~actorname)
APIFY_REDDIT_ACTOR=trudax~reddit-scraper-lite
# Pay-per-result Twitter scraper that works on Apify free plan.
APIFY_TWITTER_ACTOR=kaitoeasyapi~twitter-x-data-tweet-scraper-pay-per-result-cheapest

# Which sources the worker pulls each cycle (comma-separated: twitter,reddit).
# Default twitter-only because Reddit is hostile to cloud-IP scraping without OAuth.
INGEST_SOURCES=twitter

# ── The Odds API ───────────────────────────────────────────
# https://the-odds-api.com  (used to fetch closing lines for grading)
ODDS_API_KEY=your_odds_api_key_here

# ── Worker config ──────────────────────────────────────────
LOG_LEVEL=INFO
# Comma-separated subreddits to monitor
REDDIT_SUBREDDITS=sportsbook,nba,nbabetting,PlayerProps,NBABets
# Comma-separated Twitter search queries (each is a separate search)
TWITTER_QUERIES=NBA player prop tonight,NBA lock tonight,NBA over under tonight,NBA spread tonight
